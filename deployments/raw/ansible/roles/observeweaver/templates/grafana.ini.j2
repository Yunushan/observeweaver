[server]
http_addr = {{ hostvars[inventory_hostname].ansible_host }}
http_port = {{ observeweaver.network.ports.grafana }}
domain = grafana.{{ observeweaver.network.domain }}
root_url = {{ 'http' if observeweaver.tls.mode == 'disabled' else 'https' }}://grafana.{{ observeweaver.network.domain }}/

[security]
admin_user = {{ lookup('ansible.builtin.ini', 'GRAFANA_ADMIN_USER', type='properties', file=observeweaver_secret_file) }}
admin_password = {{ lookup('ansible.builtin.ini', 'GRAFANA_ADMIN_PASSWORD', type='properties', file=observeweaver_secret_file) }}
disable_gravatar = true
cookie_secure = {{ 'false' if observeweaver.tls.mode == 'disabled' else 'true' }}
cookie_samesite = strict

[users]
allow_sign_up = false

{% if observeweaver.components.grafana.replicas | int > 1 %}
[database]
type = postgres
host = {{ lookup('ansible.builtin.ini', 'GRAFANA_DATABASE_HOST', type='properties', file=observeweaver_secret_file) }}
name = {{ lookup('ansible.builtin.ini', 'GRAFANA_DATABASE_NAME', type='properties', file=observeweaver_secret_file, default='grafana') }}
user = {{ lookup('ansible.builtin.ini', 'GRAFANA_DATABASE_USER', type='properties', file=observeweaver_secret_file, default='grafana') }}
password = {{ lookup('ansible.builtin.ini', 'POSTGRES_PASSWORD', type='properties', file=observeweaver_secret_file) }}
ssl_mode = require
{% endif %}
