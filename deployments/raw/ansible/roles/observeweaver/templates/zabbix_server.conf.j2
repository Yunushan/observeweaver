# Managed by ObserveWeaver.
LogFile=/var/log/zabbix/zabbix_server.log
LogFileSize=0
PidFile=/run/zabbix/zabbix_server.pid
SocketDir=/run/zabbix
DBHost={{ zabbix_database_host }}
DBPort={{ zabbix_database_port }}
DBName={{ zabbix_database_name }}
DBUser={{ zabbix_database_user }}
DBPassword={{ zabbix_database_password }}
ListenPort={{ observeweaver.network.ports.zabbixServer }}
{% if groups.get('zabbix', []) | length > 1 %}
HANodeName={{ inventory_hostname }}
NodeAddress={{ hostvars[inventory_hostname].ansible_host }}:{{ observeweaver.network.ports.zabbixServer }}
{% endif %}
