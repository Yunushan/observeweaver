process.roles=broker,controller
node.id={{ observeweaver_kafka_node_id }}
controller.quorum.voters={% for host in groups['kafka'] %}{{ loop.index }}@{{ hostvars[host].ansible_host }}:{{ observeweaver.network.ports.kafkaController }}{% if not loop.last %},{% endif %}{% endfor %}
listeners=INTERNAL://0.0.0.0:{{ observeweaver.network.ports.kafka }},CONTROLLER://0.0.0.0:{{ observeweaver.network.ports.kafkaController }}
advertised.listeners=INTERNAL://{{ ansible_host }}:{{ observeweaver.network.ports.kafka }}
listener.security.protocol.map=INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
inter.broker.listener.name=INTERNAL
controller.listener.names=CONTROLLER
log.dirs={{ observeweaver_kafka_data_dir }}
num.partitions=3
offsets.topic.replication.factor={{ observeweaver_kafka_replication_factor }}
transaction.state.log.replication.factor={{ observeweaver_kafka_replication_factor }}
transaction.state.log.min.isr={{ observeweaver_kafka_min_isr }}
share.coordinator.state.topic.replication.factor={{ observeweaver_kafka_replication_factor }}
share.coordinator.state.topic.min.isr={{ observeweaver_kafka_min_isr }}
group.initial.rebalance.delay.ms=0
auto.create.topics.enable=false
unclean.leader.election.enable=false
