storage:
  dbPath: {{ observeweaver_mongodb_data_path }}

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

net:
  port: {{ observeweaver.network.ports.mongodb }}
  bindIp: 127.0.0.1,{{ hostvars[inventory_hostname].ansible_host }}
{% if ':' in hostvars[inventory_hostname].ansible_host %}
  ipv6: true
{% endif %}

security:
  authorization: enabled
  keyFile: /etc/mongodb-observeweaver-keyfile

{% if observeweaver.deployment.mode == 'cluster' %}
replication:
  replSetName: observeweaver
{% endif %}

processManagement:
  timeZoneInfo: /usr/share/zoneinfo
