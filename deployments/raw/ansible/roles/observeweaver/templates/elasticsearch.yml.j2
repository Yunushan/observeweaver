cluster.name: observeweaver-elastic
node.name: {{ inventory_hostname }}
path.data: {{ observeweaver_data_root }}/elasticsearch
network.host: {{ ansible_host }}
http.port: {{ observeweaver.network.ports.elasticsearch }}
transport.port: {{ observeweaver.network.ports.elasticsearchTransport }}
{% if observeweaver.deployment.mode == 'standalone' %}
discovery.type: single-node
{% else %}
discovery.seed_hosts:
{% for host in groups.get('elasticsearch', []) %}
  - {{ hostvars[host].ansible_host }}:{{ observeweaver.network.ports.elasticsearchTransport }}
{% endfor %}
cluster.initial_master_nodes:
{% for host in groups.get('elasticsearch', []) %}
  - {{ host }}
{% endfor %}
node.roles: [ master, data, ingest, remote_cluster_client ]
{% endif %}
bootstrap.memory_lock: true
xpack.security.enabled: true
xpack.security.http.ssl.enabled: true
xpack.security.http.ssl.certificate: /etc/elasticsearch/observeweaver-node.pem
xpack.security.http.ssl.key: /etc/elasticsearch/observeweaver-node-key.pem
xpack.security.http.ssl.certificate_authorities: [ /etc/elasticsearch/observeweaver-root-ca.pem ]
xpack.security.transport.ssl.enabled: true
xpack.security.transport.ssl.verification_mode: certificate
xpack.security.transport.ssl.certificate: /etc/elasticsearch/observeweaver-node.pem
xpack.security.transport.ssl.key: /etc/elasticsearch/observeweaver-node-key.pem
xpack.security.transport.ssl.certificate_authorities: [ /etc/elasticsearch/observeweaver-root-ca.pem ]
